{
  "name": "@ststgc/pi-telegram",
  "version": "0.25.0",
  "private": true,
  "description": "Telegram runtime adapter for Pi",
  "keywords": [
    "pi-package",
    "pi",
    "telegram",
    "bot",
    "extension"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ststgc/pi-telegram.git"
  },
  "homepage": "https://github.com/ststgc/pi-telegram",
  "bugs": {
    "url": "https://github.com/ststgc/pi-telegram/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-reporter=dot tests/*.test.ts",
    "test:verbose": "node --experimental-strip-types --test --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "audit": "node --experimental-strip-types scripts/audit-dependencies.ts",
    "pack:check": "npm pack --dry-run",
    "pack:smoke": "node --experimental-strip-types scripts/smoke-package.ts",
    "domain-dag": "bash -c \"SKILL_DIR=.agents/skills/domain-dag bash .agents/skills/domain-dag/scripts/validate-domain-dag.sh --root .\"",
    "validate": "npm run typecheck && npm test && npm run audit && npm run domain-dag && npm run pack:check && npm run pack:smoke"
  },
  "files": [
    "index.ts",
    "api/",
    "lib/",
    "README.md",
    "AGENTS.md",
    "BACKLOG.md",
    "CHANGELOG.md",
    "docs/",
    "scripts/",
    "screenshot.png"
  ],
  "exports": {
    ".": "./index.ts",
    "./inbound": "./api/inbound.ts",
    "./outbound": "./api/outbound.ts",
    "./delivery": "./api/delivery.ts",
    "./interactions": "./api/interactions.ts",
    "./activity": "./api/activity.ts",
    "./updates": "./api/updates.ts",
    "./commands": "./api/commands.ts",
    "./sections": "./api/sections.ts",
    "./status": "./api/status.ts",
    "./voice": "./api/voice.ts",
    "./keyboard": "./api/keyboard.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://github.com/ststgc/pi-telegram/raw/main/screenshot.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.80.6",
    "@earendil-works/pi-ai": ">=0.80.6",
    "@earendil-works/pi-coding-agent": ">=0.80.6",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "brace-expansion": "5.0.7",
    "protobufjs": "7.6.5",
    "undici": "8.5.0",
    "ws": "8.21.0",
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.7",
      "protobufjs": "7.6.5",
      "undici": "8.5.0",
      "ws": "8.21.0",
      "@google/genai": {
        "protobufjs": "7.6.5",
        "ws": "8.21.0"
      },
      "@earendil-works/pi-ai": {
        "protobufjs": "7.6.5",
        "ws": "8.21.0",
        "@google/genai": {
          "protobufjs": "7.6.5",
          "ws": "8.21.0"
        }
      }
    }
  }
}
